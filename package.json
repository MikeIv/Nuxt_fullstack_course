{
  "name": "nuxt-fullstack-course",
  "version": "0.1.0",
  "description": "Интерактивный курс «Бэкенд Nuxt fullstack»: 12 уроков, прогресс, практика по реальному проекту",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-sources.mjs && nuxt build",
    "dev": "node scripts/sync-sources.mjs && nuxt dev",
    "generate": "node scripts/sync-sources.mjs && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/sync-sources.mjs && nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.{vue,css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{vue,css,scss}\" --fix --allow-empty-input",
    "lint:all": "eslint . && pnpm format:check && stylelint \"**/*.{vue,css,scss}\" --allow-empty-input",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint:all && node .cursor/check-rules.mjs && pnpm typecheck && pnpm test",
    "rules:sync": "node .cursor/sync-rules.mjs",
    "figma:meta": "node scripts/figma.mjs meta",
    "figma:nodes": "node scripts/figma.mjs nodes",
    "figma:png": "node scripts/figma.mjs png"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "shiki": "^4.5.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.14",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-order": "^8.1.1",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.8"
  }
}
