# Публичные переменные окружения (префикс NUXT_PUBLIC_ попадает на клиент)
# Базовый URL HTTP API без завершающего слэша. Свои ручки — на этом же origin, поэтому
# обычно пусто: NUXT_PUBLIC_API_BASE=
# NUXT_PUBLIC_API_BASE=https://api.example.com

NUXT_PUBLIC_API_BASE=

# Подпись приложения в шапке и в <title>
NUXT_PUBLIC_APP_NAME=Бэкенд Nuxt fullstack

# Только dev: корень проекта, по которому проверяется практика (Olimp).
# В прод-сборке ручка /api/practice/scan не регистрируется.
NUXT_PRACTICE_PROJECT_ROOT=D:\_WEB\_Work\Grand\Olimp_fitnes_landing
